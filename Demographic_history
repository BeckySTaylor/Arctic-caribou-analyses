#Input map file needs re-formatting. Needs to be a column with just chromosome number, then SNP name (e.g. SNP1, SNP2 etc), third column all zeros as we dont know genetic location in centimorgans, and then position.
#Need to edit the first column to have chromsome number.
#Make a file with just the second column which contains the chromosome information

awk '{print $2}' DU_10_autosomes_biallelic_thinned_1000.map > DU_10_autosomes_biallelic_thinned_1000_GONE_chromosomes_only

#Remove everything after the colon:

sed -i 's/\:.*//' DU_10_autosomes_biallelic_thinned_1000_GONE_chromosomes_only
 
#So now have list of chromsomes. Need to change them to just the number so for each chromosome do a replace in the file
 
sed -i 's/\OX459937.2/1/' DU_10_autosomes_biallelic_thinned_1000_chromosomes_only
sed -i 's/\OX459938.2/2/' DU_10_autosomes_biallelic_thinned_1000_chromosomes_only
etc
 
#Now need to remove the first column of the map file and add this instead 
 
awk '{print $2, $3, $4}' DU_10_autosomes_biallelic_thinned_1000.map > DU_10_autosomes_biallelic_thinned_1000_new.map
  
paste -d' ' DU_10_autosomes_biallelic_thinned_1000_GONE_chromosomes_only DU_10_autosomes_biallelic_thinned_1000_new.map > DU_10_autosomes_biallelic_thinned_1000_new2.map

#Rename unedited map file and this new one:

mv ./DU_10_autosomes_biallelic_thinned_1000.map ./DU_10_autosomes_biallelic_thinned_1000_Unedited.map

mv ./DU_10_autosomes_biallelic_thinned_1000_new2.map ./DU_10_autosomes_biallelic_thinned_1000.map

#Now have final map file.

#The ped file also needs editing, the column before the genotypes must be all -9, this will make column 6 all -9

awk '{$6=-9 ; print ;}' DU_10_autosomes_biallelic_thinned_1000.ped > DU_10_autosomes_biallelic_thinned_1000_edit.ped

#Rename unedited ped file and this new one:

mv ./DU_10_autosomes_biallelic_thinned_1000.ped ./DU_10_autosomes_biallelic_thinned_1000_unedited.ped

mv ./DU_10_autosomes_biallelic_thinned_1000_edit.ped ./DU_10_autosomes_biallelic_thinned_1000.ped

#Then can run GONE, input parameters file used included as a separate file:

bash script_GONE.sh DU_10_autosomes_biallelic_thinned_1000
