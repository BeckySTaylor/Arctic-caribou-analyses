###ROH overlaps short ROHs

Proprtion_ROH <- read.csv(file="ROH_Overlaps_5missing.csv")
Ordered_Proprtion_ROH <- Proprtion_ROH
Ordered_Proprtion_ROH$Population <- factor(Ordered_Proprtion_ROH$Population, levels = c("Baffin","Barren-ground","Dolphin Union","Banks","Other Peary"))

model1 <- lm(Proportion_total_DoS_genes ~ FROH, data = Ordered_Proprtion_ROH)
r_squared1 <- summary(model1)$r.squared
p_value1 <- summary(model1)$coefficients[2, 4]  # p-value for the slope

p1 <- ggplot(Ordered_Proprtion_ROH, aes(x=FROH, y=Proportion_total_DoS_genes)) + geom_point(aes(color = Population), size=2) +
  scale_color_manual(values=c("#1F78B4", "#B2DF8A", "#33A02C", "#E31A1C", "#FDBF6F"))+
  geom_smooth(method=lm, color="darkgrey") +
  geom_abline (slope=1, linetype = "dashed", color="black")+
  # Add R² and p-value annotation in top left corner
  annotate("text", 
           x = -Inf, 
           y = Inf, 
           label = paste0("R² = ", round(r_squared1, 3), "; p = ", 
                          ifelse(p_value1 < 0.001, "< 0.001", round(p_value1, 3))),
           hjust = -0.1, 
           vjust = 1.5, 
           size = 6) +
  theme(axis.text.x = element_text(angle = 45, hjust=1),panel.background = element_rect(fill = "white",colour = "black",size = 0.5, linetype = "solid"),
        panel.grid.major = element_blank(), 
        panel.grid.minor = element_blank())+
  xlab("FROH") +
  ylab("Proportion genes with DoS score of 0 in ROH")

