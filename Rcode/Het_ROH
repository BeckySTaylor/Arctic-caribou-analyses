library("ggplot2")
library(patchwork)

Het_results <- read.csv(file="mlRho_82_NoGNL_15X_6_BRG_PRY.csv")
Het_results$PCID <- as.factor(Het_results$PCID)

#Re-order the bars and legend manually
Ordered_Het <- Het_results
Ordered_Het$DU <- factor(Ordered_Het$DU, levels = c("Baffin Island","Barren-ground","Dolphin Union","Boothia","Banks Island","Other Peary"))

p1 <- ggplot(Ordered_Het, aes(x=DU, y=Heterozygosity, fill=DU)) + scale_fill_manual(values=c("#1F78B4","#B2DF8A","#33A02C","#FB9A99","#E31A1C","#FDBF6F"))+ theme_classic()+ theme(legend.position="none", axis.text=element_text(size=12),axis.title=element_text(size=16))+ 
  xlab("Population") +
  ylab("Heterozygosity")+
  geom_boxplot()


