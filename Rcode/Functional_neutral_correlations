library(ggplot2)
library(patchwork)

#First het all vs all synonymous and all non-synonymous sites

Heterozygosity <- read.csv(file="All_96_Filter2_Biallelic_het_proportions_5missing_ReDo.csv")
Ordered_Heterozygosity <- Heterozygosity
Ordered_Heterozygosity$Population <- factor(Ordered_Heterozygosity$Population, levels = c("Baffin","Barren-ground","Dolphin Union","Banks","Other Peary"))

# Calculate R² and p-value
model1 <- lm(Het_Syn ~ Het_all, data = Ordered_Heterozygosity)
r_squared1 <- summary(model1)$r.squared
p_value1 <- summary(model1)$coefficients[2, 4]  # p-value for the slope

p1 <- ggplot(Ordered_Heterozygosity, aes(x=Het_all, y=Het_Syn)) + geom_point(aes(color = Population), size=2) +
  scale_color_manual(values=c("#1F78B4", "#B2DF8A", "#33A02C", "#E31A1C", "#FDBF6F"))+
  geom_smooth(method=lm, color="darkgrey") +
  # Add R² and p-value annotation in top left corner
  annotate("text", 
           x = -Inf, 
           y = Inf, 
           label = paste0("R² = ", round(r_squared1, 3), "; p = ", 
                          ifelse(p_value1 < 0.001, "< 0.001", round(p_value1, 3))),
           hjust = -0.1, 
           vjust = 1.5, 
           size = 5) +
  theme(axis.text.x = element_text(angle = 45, hjust=1),panel.background = element_rect(fill = "white",colour = "black",size = 0.5, linetype = "solid"),
        panel.grid.major = element_blank(), 
        panel.grid.minor = element_blank())+
  xlab("Proportion het all sites") +
  ylab("Proportion het synonymous sites")

model2 <- lm(Het_nonSyn ~ Het_all, data = Ordered_Heterozygosity)
r_squared2 <- summary(model2)$r.squared
p_value2 <- summary(model2)$coefficients[2, 4]  # p-value for the slope

p2 <- ggplot(Ordered_Heterozygosity, aes(x=Het_all, y=Het_nonSyn)) + geom_point(aes(color = Population), size=2) +
  scale_color_manual(values=c("#1F78B4", "#B2DF8A", "#33A02C", "#E31A1C", "#FDBF6F"))+
  geom_smooth(method=lm, color="darkgrey") +
  # Add R² and p-value annotation in top left corner
  annotate("text", 
           x = -Inf, 
           y = Inf, 
           label = paste0("R² = ", round(r_squared2, 3), "; p = ", 
                          ifelse(p_value2 < 0.001, "< 0.001", round(p_value2, 3))),
           hjust = -0.1, 
           vjust = 1.5, 
           size = 5) +
  theme(axis.text.x = element_text(angle = 45, hjust=1),panel.background = element_rect(fill = "white",colour = "black",size = 0.5, linetype = "solid"),
        panel.grid.major = element_blank(), 
        panel.grid.minor = element_blank())+
  xlab("Proportion het all sites") +
  ylab("Proportion het non-synonymous sites")


Het_scatters <- ((p1|p2))+
  plot_annotation(tag_levels = 'A') #add figure labels

#Save as PDF
pdf("Proportion_het_scatter_plots_5missing_allSyn_allNonSyn_Rsq.pdf", height=6, width=16)
